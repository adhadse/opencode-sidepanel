{
  "name": "opencode-sidepanel",
  "version": "2.0.0",
  "description": "A configurable, plugin-owned sidebar for OpenCode V2",
  "private": true,
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun build.ts && bun run bundle:installer",
    "typecheck": "tsgo --noEmit",
    "prepare": "bun run build",
    "bundle:installer": "bun scripts/build-installer.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "solid-js": "1.9.15"
  }
}
